VITE_API_URL=/api
VITE_SOCKET_URL=
VITE_SOCKET_PATH=/socket.io
VITE_DEMO_OFFICE_SLUG=ward-16-office-lalitpur
VITE_PUBLIC_URL=

# Split-origin production example:
# VITE_API_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com

# Testing on a phone over LAN (run `vite --host` in frontend/): without
# this, QR codes on Dashboard/Setup/Display encode window.location.origin,
# which is http://localhost:5173 if that's what you used to view the page
# on your laptop — a phone scanning it resolves "localhost" to itself, not
# your laptop, and the link fails. Set this to your laptop's LAN address
# (`ipconfig getifaddr en0` on macOS) so QR codes stay scannable regardless
# of which host you happen to browse the dashboard from:
# VITE_PUBLIC_URL=http://192.168.1.50:5173
