MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/noq
NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated, exact frontend origins; never use * with credentials.
CLIENT_ORIGIN=http://localhost:5173
SOCKET_PATH=/socket.io
# Set to the number of trusted reverse proxies. Most managed hosts use 1.
TRUST_PROXY=0

# SMTP delivery for password-reset links. In non-production without SMTP,
# the reset URL is returned in the response for local development only.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NoQ <no-reply@example.com>

# Twilio Programmable Messaging
TWILIO_ACCOUNT_SID=ACreplace-with-your-account-sid
TWILIO_AUTH_TOKEN=replace-with-your-auth-token
# Configure either a Messaging Service SID or a Twilio sender number.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+977
# Trial accounts reject custom text (error 572006) and only accept one of
# Twilio's fixed template names — set so real notifications still deliver
# during a demo (recipient gets Twilio's canned text, not NoQ's actual
# message). Delete once the account is upgraded to paid.
TWILIO_TRIAL_TEMPLATE_BODY=

# Google Routes API for traffic-aware travel estimates. Without this key,
# NoQ uses a clearly labeled straight-line development estimate.
GOOGLE_MAPS_API_KEY=replace-with-your-google-maps-api-key
ROUTES_TRAVEL_MODE=DRIVE
ARRIVAL_BUFFER_MINUTES=5
TRAVEL_FALLBACK_SPEED_KPH=20
